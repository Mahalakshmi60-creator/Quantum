# Quantum Random Number Generator (QRNG) - Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Quantum Backend Settings
QUANTUM_SIMULATOR=qiskit_statevector
MAX_BITS=4096

# Optional: Real Hardware Integration (IBM Quantum Experience)
# Obtain your API token from https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=your_ibm_quantum_api_token_here
IBM_QUANTUM_CHANNEL=ibm_quantum
IBM_QUANTUM_INSTANCE=ibm-q/open/main
